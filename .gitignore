# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
PDLabTest/Saved/*
# Compiled source files for the engine to use
Intermediate/*
PDLabTest/Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/
**/DerivedDataCache/**

# Unreal folders inside the PDLabTest project
PDLabTest/Intermediate/
PDLabTest/Plugins/*/Intermediate/
PDLabTest/DerivedDataCache/
PDLabTest/Saved/
PDLabTest/.claude/
PDLabTest/.vs/
*.pdb
*.slnx
.vsconfig

# Keep project/plugin binaries and plugin third-party libraries so another PC
# can open the project without compiling
!PDLabTest/Binaries/
!PDLabTest/Binaries/**
!PDLabTest/Plugins/**/Binaries/
!PDLabTest/Plugins/**/Binaries/**
!PDLabTest/Plugins/**/*.dll
!PDLabTest/Plugins/**/*.lib
!PDLabTest/Plugins/**/*.so
!PDLabTest/Plugins/**/*.a
!PDLabTest/Binaries/**/*.dll

# Keep built lighting so maps don't need a lighting rebuild after pulling
!*_BuiltData.uasset

# Debug symbols are large and not needed to run the editor
*.pdb
